instrument: drumkit
tempo: 104
humanize:
  timing: 0.018               # beat units (±0.015 of a beat)
  velocity: 6                 # MIDI units (±6)
  timingBias: -0.1            # -1 = always drag, +1 = rush
  seed: 42                    # reproducibility

# 8 bars of 7/8 = 56 beats. Every default drumkit line (C, C2, X,
# L, R, H, T1-T5, S, K, Hp) is declared in every measure so you
# can drop hits onto any instrument by editing its row in place.
# Silent rows are `----:----:...` placeholders.
#
# Bar map (currently active hits):
#   bar 1: C (open crash)        bar 5: X  (china)
#   bar 2: Hp (hihat pedal)      bar 6: C2 (second crash)
#   bar 3: R  (ride bell)        bar 7: T1-T5 tom fill + C
#   bar 4: L  (splash)           bar 8: C  (closing crash)
#
# 2+2+3 grouping: kick on 1 and 5, snare on 3 and 6 (bar 1 on 2/6).
# Order in each block: cymbals → ride → hihat → toms (high→low)
#   → snare → kick → hihat pedal.

