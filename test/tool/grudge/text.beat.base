instrument: drumkit
tempo: 98

# Tool — "The Grudge". Full song.
# Source: https://tabs.ultimate-guitar.com/tab/tool/the-grudge-drums-880611
# Original tab in base.txt; this is the colon-separated rendering.
#
# Voice mapping from the original:
#   T → T1   (rack tom)
#   t → T2   (small / aux tom)
#   f → T4   (small floor tom)
#   F → T5   (large floor tom)
#   B → K    (bass drum)
#   S → S    (snare)
#   H → H    (hihat)
#   Hf → Hp  (hihat foot/pedal)
#   C → C    (crash 1)
#   R → R    (ride)
#   I → X    (china)
#   E        skipped (electronics — no drum mapping)
#
# Sections that are entirely electronics include silent K rows so
# the song timing stays right.

