{
  "name": "@cluesurf/beat",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "description": "TypeScript MIDI engine that drives Logic Pro / Superior Drummer 3 via the macOS IAC virtual MIDI bus.",
  "type": "module",
  "scripts": {
    "try": "tsx code/console/index.ts try",
    "list:ports": "tsx code/console/index.ts list-ports",
    "play": "tsx code/console/index.ts play",
    "export": "tsx code/console/index.ts export",
    "text:make": "cd text && pnpm exec vsce package",
    "text:load": "cd text && pnpm exec vsce package && code --install-extension $(ls -t beat-code-*.vsix | head -1)",
    "text:host": "cd text && pnpm exec vsce publish",
    "text:login": "cd text && pnpm exec vsce login cluesurf",
    "text:view": "cd text && pnpm view"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "dependencies": {
    "@types/lodash-es": "catalog:",
    "easymidi": "catalog:",
    "lodash-es": "catalog:",
    "yaml": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@cluesurf/wash": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "concurrently": "catalog:",
    "dotenv": "catalog:",
    "fs-extra": "catalog:",
    "js-yaml": "catalog:",
    "kysely-codegen": "catalog:",
    "opentype.js": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yargs": "catalog:",
    "zod": "catalog:"
  }
}
