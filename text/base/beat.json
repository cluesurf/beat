{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BeatCode",
  "scopeName": "source.beat",
  "patterns": [
    { "include": "#comments" },
    { "include": "#tab-row" },
    { "include": "#known-keys" },
    { "include": "#yaml-key" },
    { "include": "#yaml-array" },
    { "include": "#yaml-object" },
    { "include": "#numbers" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.beat",
          "match": "(^|\\s)#.*$"
        }
      ]
    },

    "known-keys": {
      "patterns": [
        {
          "begin": "^\\s*(instrument|tempo|humanize|flow|rate|measure|time|part|velocity|hit|note|flam)\\s*(:)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.key.beat" },
            "2": { "name": "punctuation.separator.key-value.beat" }
          },
          "end": "(?=#)|$",
          "patterns": [
            { "include": "#numbers" },
            { "include": "#strings" },
            { "include": "#unquoted-value" }
          ]
        }
      ]
    },

    "yaml-key": {
      "patterns": [
        {
          "begin": "^\\s*([A-Za-z_][A-Za-z0-9_-]*)\\s*(:)(?!\\|)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.key.beat" },
            "2": { "name": "punctuation.separator.key-value.beat" }
          },
          "end": "(?=#)|$",
          "patterns": [
            { "include": "#numbers" },
            { "include": "#strings" },
            { "include": "#unquoted-value" }
          ]
        }
      ]
    },

    "unquoted-value": {
      "patterns": [
        {
          "name": "support.type.value.beat",
          "match": "[A-Za-z][A-Za-z0-9_-]*"
        }
      ]
    },

    "yaml-array": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.beat" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.array.end.beat" }
      },
      "patterns": [
        { "include": "#numbers" },
        { "include": "#strings" },
        {
          "match": ",",
          "name": "punctuation.separator.array.beat"
        }
      ]
    },

    "yaml-object": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.dictionary.begin.beat" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.dictionary.end.beat" }
      },
      "patterns": [
        { "include": "#known-keys" },
        { "include": "#yaml-key" },
        { "include": "#numbers" },
        { "include": "#strings" },
        {
          "match": ",",
          "name": "punctuation.separator.dictionary.pair.beat"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "match": "(\\d+)\\s*(\\*)\\s*(\\d+(?:\\.\\d+)?)",
          "captures": {
            "1": { "name": "constant.numeric.beat" },
            "2": { "name": "comment.line.silence.beat" },
            "3": { "name": "constant.numeric.beat" }
          }
        },
        {
          "match": "(\\d+)\\s*(/)\\s*(\\d+)",
          "captures": {
            "1": { "name": "constant.numeric.beat" },
            "2": { "name": "comment.line.silence.beat" },
            "3": { "name": "constant.numeric.beat" }
          }
        },
        {
          "match": "(\\d+)\\s*(:)\\s*(\\d+)",
          "captures": {
            "1": { "name": "support.type.ratio.beat" },
            "2": { "name": "comment.line.silence.beat" },
            "3": { "name": "support.type.ratio.beat" }
          }
        },
        {
          "name": "constant.numeric.beat",
          "match": "(?<![A-Za-z0-9_-])\\d+(\\.\\d+)?(?![A-Za-z_-])"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.beat",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.beat",
          "begin": "'",
          "end": "'"
        }
      ]
    },

    "tab-row": {
      "begin": "^(\\s*)([A-Z][A-Za-z0-9]*)\\s*(\\|)",
      "beginCaptures": {
        "2": { "name": "keyword.control.line-name.beat" },
        "3": { "name": "constant.language.bar.beat" }
      },
      "end": "$",
      "name": "meta.tab-row.beat",
      "patterns": [
        {
          "name": "constant.language.bar.beat",
          "match": "\\|"
        },
        {
          "name": "constant.language.beat-separator.beat",
          "match": ":"
        },
        {
          "name": "comment.line.silence.beat",
          "match": "-+"
        },
        {
          "name": "entity.name.function.tab-note.accent.beat",
          "match": "[OXJB]"
        },
        {
          "name": "entity.name.function.tab-note.beat",
          "match": "[xobcdgfr]"
        },
        {
          "name": "entity.name.function.tab-note.combining.beat",
          "match": "[a-zA-Z][\\u0300-\\u036f]+"
        },
        {
          "name": "invalid.illegal.tab-note.beat",
          "match": "[^\\s|:o\\-xOXJBcdgfr\\u0300-\\u036f]"
        }
      ]
    }
  }
}
