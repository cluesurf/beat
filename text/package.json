{
  "name": "beat-text",
  "icon": "view/beat.png",
  "displayName": "BeatText",
  "description": "BeatText Syntax Highlighter for .beat tab files",
  "version": "1.0.8",
  "license": "MIT",
  "publisher": "cluesurf",
  "scripts": {
    "dock": "vsce login cluesurf",
    "make": "vsce package",
    "host": "vsce publish",
    "view": "convert -background none -resize 1024x view/beat.svg view/beat.png"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cluesurf/beat.git"
  },
  "engines": {
    "vscode": "^1.59.0"
  },
  "categories": ["Programming Languages"],
  "devDependencies": {
    "prettier": "3.8.1"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "beat",
        "label": "Beat",
        "path": "./view/view.json"
      }
    ],
    "configurationDefaults": {
      "[beat]": {
        "editor.wordWrap": "off",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.tabCompletion": "on",
        "editor.wordSeparators": " :|",
        "editor.bracketPairColorization.enabled": false,
        "editor.renderWhitespace": "boundary",
        "editor.fontFamily": "Menlo, monospace"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.silence.beat",
            "settings": { "fontStyle": "" }
          },
          {
            "scope": "comment.line.number-sign.beat",
            "settings": { "fontStyle": "" }
          },
          {
            "scope": "variable.parameter.key.beat",
            "settings": { "fontStyle": "", "foreground": "#F1FA8C" }
          },
          {
            "scope": "keyword.control.line-name.beat",
            "settings": { "fontStyle": "" }
          },
          {
            "scope": "constant.language.bar.beat",
            "settings": { "fontStyle": "" }
          },
          {
            "scope": "constant.language.beat-separator.beat",
            "settings": { "fontStyle": "" }
          },
          {
            "scope": "constant.numeric.beat",
            "settings": { "fontStyle": "", "foreground": "#8BE9FD" }
          },
          {
            "scope": "support.type.ratio.beat",
            "settings": { "fontStyle": "", "foreground": "#8BE9FD" }
          },
          {
            "scope": "support.type.value.beat",
            "settings": { "fontStyle": "", "foreground": "#8BE9FD" }
          },
          {
            "scope": "constant.numeric.velocity.beat",
            "settings": { "fontStyle": "", "foreground": "#8BE9FD" }
          },
          {
            "scope": "entity.name.function.tab-note.beat",
            "settings": { "fontStyle": "" }
          },
          {
            "scope": "entity.name.function.tab-note.accent.beat",
            "settings": { "fontStyle": "" }
          },
          {
            "scope": "entity.name.function.tab-note.combining.beat",
            "settings": { "fontStyle": "" }
          }
        ]
      }
    },
    "languages": [
      {
        "id": "beat",
        "aliases": ["Beat", "BeatText", "beat"],
        "extensions": [".beat"],
        "configuration": "./base/bind.json"
      },
      {
        "id": "beat-markdown-injection"
      }
    ],
    "grammars": [
      {
        "language": "beat",
        "scopeName": "source.beat",
        "path": "./base/beat.json"
      },
      {
        "language": "beat-markdown-injection",
        "scopeName": "markdown.beat.codeblock",
        "path": "./base/mark.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.beat": "beat"
        }
      }
    ]
  }
}
